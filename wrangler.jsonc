{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gsv-mart",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/uploads/*", "/healthz"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "gsv-mart-db",
    "database_id": "387a76c0-9ccc-4d18-9af6-c4b141662611",
    "migrations_dir": "cloudflare/migrations"
  }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "gsv-mart-photos" }]
}
